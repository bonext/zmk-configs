#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define ADJUST  3
#define HYPER   4
#define GAME    5

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <(-1)>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                                                                               &kp N6  &kp N7  &kp N8     &kp N9   &kp N0         &kp BACKSPACE
&none      &kp Q   &kp W   &kp E   &kp R   &kp T                                                                                &kp Y   &kp U   &kp I      &kp O    &kp P          &kp MINUS
&kp CAPS   &kp A   &kp S   &kp D   &kp F   &kp G                                                                                &kp H   &kp J   &kp K      &kp L    &kp SEMICOLON  &kp SQT
&none      &kp Z   &kp X   &kp C   &kp V   &kp B            &kp LALT   &kp K_CONTEXT_MENU  &kp RIGHT_GUI  &kp LALT              &kp N   &kp M   &kp COMMA  &kp DOT  &kp SLASH      &kp NON_US_BACKSLASH
&kp ESC    &none   &none   &mo 1                   &kp TAB  &kp LCTRL  &kp LSHIFT          &kp RSHIFT     &kp RCTRL  &kp SPACE                  &mo 2      &none    &none          &kp ENTER
            >;
        };

        lower_layer {
            bindings = <
&none  &none  &none  &none  &none  &none                                                                              &none  &none             &none              &none           &none            &kp DEL
&none  &none  &none  &none  &none  &none                                                                              &none  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &none
&none  &none  &none  &none  &none  &none                                                                              &none  &kp LEFT_ARROW    &kp DOWN_ARROW     &kp UP_ARROW    &kp RIGHT_ARROW  &none
&none  &none  &none  &none  &none  &none         &kp LALT   &kp K_CONTEXT_MENU  &kp RIGHT_GUI    &kp LEFT_ALT         &none  &kp PLUS          &kp EQUAL          &none           &none            &none
&none  &none  &none  &none                &none  &kp LCTRL  &kp LEFT_SHIFT      &kp RIGHT_SHIFT  &kp RCTRL     &none                           &none              &none           &none            &none
            >;
        };

        raise_layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                                     &none  &none     &none          &none        &none    &bt BT_CLR_ALL
&none         &kp F1        &kp F2        &kp F3        &kp F4        &none                                                                     &none  &none     &none          &none        &none    &none
&kp INSERT    &kp F5        &kp F6        &kp F7        &kp F8        &none                                                                     &none  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END  &none
&none         &kp F9        &kp F10       &kp F11       &kp F12       &none         &kp LALT   &kp K_CONTEXT_MENU  &kp RGUI   &kp LALT          &none  &none     &none          &none        &none    &none
&none         &none         &none         &none                              &none  &kp LCTRL  &kp LSHFT           &kp RSHFT  &kp RCTRL  &none                   &none          &none        &none    &none
            >;
        };
    };
};
